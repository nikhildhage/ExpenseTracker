{
  "nodeModulesDir": "auto",
  "fmt": {
    "exclude": ["dist", "graphify-out"]
  },
  "tasks": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "deno run -A npm:vite preview",
    "depcheck": "deno run -A npm:depcheck",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check"
  }
}
