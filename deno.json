{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "deno run -A npm:vite preview",
    "depcheck": "deno run -A npm:depcheck",
    "fmt": "deno run -A npm:prettier@3.9.6 --write .",
    "fmt:check": "deno run -A npm:prettier@3.9.6 --check ."
  },
  "fmt": {
    "exclude": ["."]
  }
}
